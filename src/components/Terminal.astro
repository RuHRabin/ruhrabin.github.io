<section class="sec wrap" id="terminal">
    <h2 class="rv">Try the terminal.</h2>
    <p class="sub rv">Type a command, or tap one. Try: whoami, skills, github, theme mac, sound on.</p>
    <div class="win glow rv">
      <div class="wt"><i class="tl"></i><i class="tl"></i><i class="tl"></i><span class="wtt">rabin@ruhrbin: ~</span></div>
      <div id="log" role="log" aria-live="polite" tabindex="0" aria-label="Terminal output"></div>
      <form class="tin" id="tf" autocomplete="off"><label for="ti">rabin@ruhrbin:~$</label><input id="ti" type="text" autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="send"></form>
      <div class="qs"><button type="button">help</button><button type="button">whoami</button><button type="button">skills</button><button type="button">github</button><button type="button">neofetch</button><button type="button">theme mac</button></div>
    </div>
  </section>
