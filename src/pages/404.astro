---
import Base from '../layouts/Base.astro';
---
<Base title="404 – Signal lost | RuHRabin" description="This page does not exist.">
  <main style="min-height:100vh;display:grid;place-content:center;gap:16px;text-align:center;padding:24px">
    <p class="mono" style="color:var(--muted);margin:0">error 404</p>
    <h1 style="font:800 clamp(48px,12vw,120px)/1 var(--head);letter-spacing:-.04em;margin:0">Signal lost</h1>
    <p style="color:var(--muted);margin:0">That page drifted past the event horizon.</p>
    <p style="margin:8px 0 0"><a class="btn" href="/">Back to home</a></p>
  </main>
</Base>
